<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CephalonCuda</RootNamespace>
    <AssemblyName>CephalonCuda</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\cuda.ico</ApplicationIcon>
    <Version>2.2.0</Version>
    <AssemblyVersion>2.2.0.0</AssemblyVersion>
    <FileVersion>2.2.0.0</FileVersion>
    <Product>Cephalon Cuda</Product>
    <Description>Warframe return-player and onboarding companion with automatic official drop intelligence, evidence-aware build synthesis, Platinum guardrails, live data, OCR, and source-stamped AI retrieval.</Description>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WFAC010: DPI awareness intentionally lives in app.manifest (PerMonitorV2) for the WPF overlay. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is referenced only for Screen bounds + System.Drawing capture buffers;
         drop its implicit usings so WPF types stay unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.29" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so single-file publish ships as exactly one exe; extracted to %LocalAppData% at runtime. -->
    <None Remove="Assets\advisor.html" />
    <EmbeddedResource Include="Assets\advisor.html" />
  </ItemGroup>

</Project>
