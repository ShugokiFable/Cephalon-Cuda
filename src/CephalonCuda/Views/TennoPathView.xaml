<UserControl x:Class="CephalonCuda.Views.TennoPathView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextElement.Foreground="{DynamicResource Brush.Text}">
    <Grid Margin="{DynamicResource Metric.PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource HeroCard}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" Margin="0,0,0,9">
                        <TextBlock Text="PERSONAL PROGRESSION OS" Style="{StaticResource Eyebrow}"/>
                    </Border>
                    <TextBlock Text="Tenno Path" Style="{StaticResource H1}" Margin="0"/>
                    <TextBlock Text="Progression memory, next-step navigation, purchase protection, redemption tracking, and a focused goal stack."
                               Style="{StaticResource Dim}" TextWrapping="Wrap" MaxWidth="760" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✦  What should I do now?" Style="{StaticResource AccentButton}"
                        Click="OnAskNext" VerticalAlignment="Center" Padding="18,9"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ACCOUNT ROADMAP" Style="{StaticResource H2}"/>
                    <TextBlock x:Name="ProgressLabel" FontFamily="Consolas" Foreground="{DynamicResource Brush.Accent}"/>
                </StackPanel>
                <ProgressBar x:Name="RoadmapProgress" Grid.Column="1" Height="10" Margin="18,8" Maximum="100"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Routine:" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RoutineLabel" Margin="6,0,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem x:Name="ReturnTab" Header="JUST GOT BACK?">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12" MaxWidth="1180" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="RETURN-PLAYER BRIEFING" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="ReturnHeadline" FontFamily="Consolas" FontSize="23" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Accent}" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="ReturnSummary" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="ReturnLastPlayed" Style="{StaticResource Dim}" Margin="0,7,0,0"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="BUILD MY RETURN PLAN" Style="{StaticResource AccentButton}" Click="OnAskReturnPlan" Margin="0,0,8,6"/>
                                        <Button Content="I PLAYED TODAY" Click="OnMarkPlayedToday" Margin="0,0,8,6"/>
                                        <Button Content="REFRESH ALL LIVE DATA" Click="OnRefreshReturnData" Margin="0,0,8,6"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="DO THIS FIRST" Style="{StaticResource H2}"/>
                                    <ItemsControl x:Name="ReturnNowList">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3"/>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="BEFORE YOU RE-INVEST" Style="{StaticResource H2}" Foreground="{DynamicResource Brush.Gold}"/>
                                    <ItemsControl x:Name="ReturnCheckList">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3"/>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="AUTOMATION" Style="{StaticResource H2}"/>
                                    <CheckBox x:Name="AutoReturnBox" Content="Show return briefing after a long absence"
                                              Checked="OnReturnAutomationChanged" Unchecked="OnReturnAutomationChanged"/>
                                    <CheckBox x:Name="AutoDataBox" Content="Refresh due databases automatically"
                                              Margin="0,8,0,0" Checked="OnReturnAutomationChanged" Unchecked="OnReturnAutomationChanged"/>
                                    <TextBlock Text="The app uses EE.log timestamps and state you confirmed. It does not fake access to private account progress."
                                               Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="DATA READINESS" Style="{StaticResource H2}"/>
                                    <ItemsControl x:Name="ReturnDataList">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,2"/>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="FAST RE-ENTRY" Style="{StaticResource H2}"/>
                                    <Button Content="CHECK MY OLD BUILD" Click="OnAskReturnBuild" Margin="0,4,0,6"/>
                                    <Button Content="WHAT CHANGED THAT MATTERS?" Click="OnAskReturnChanges" Margin="0,0,0,6"/>
                                    <Button Content="MAKE A 60-MINUTE SESSION" Click="OnAskReturnSession"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="RoadmapTab" Header="NEXT STEPS">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <ComboBox x:Name="PhaseFilter" Width="190" SelectionChanged="OnRoadmapSelectionChanged"/>
                            <CheckBox x:Name="ShowFinished" Content="Show completed / skipped" Margin="12,0,0,0"
                                      Checked="OnRoadmapFilterChanged" Unchecked="OnRoadmapFilterChanged"/>
                        </StackPanel>
                        <ListBox x:Name="RoadmapList" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding State}" Margin="8,0,0,0" FontFamily="Consolas" FontSize="10"
                                                               Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Meta}" Style="{StaticResource Dim}" FontFamily="Consolas" Margin="0,2,0,5"/>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding WhyItMatters}" TextWrapping="Wrap" Margin="0,5,0,0" Style="{StaticResource Dim}"/>
                                                <TextBlock Text="{Binding ActionHint}" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource Brush.Gold}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <Button Content="✓ Done" Tag="{Binding}" Click="OnTaskDone" Margin="0,0,0,5"/>
                                                <Button Content="◆ Pin" Tag="{Binding}" Click="OnTaskPin" Margin="0,0,0,5"/>
                                                <Button Content="Ask AI" Tag="{Binding}" Click="OnTaskAsk" Margin="0,0,0,5"/>
                                                <Button Content="Skip" Tag="{Binding}" Click="OnTaskSkip"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="THE BEGINNER FIREWALL" Style="{StaticResource H2}"/>
                                <TextBlock TextWrapping="Wrap" Text="Starter Platinum is not spending money. Treat it as permanent account capacity. Slots first; never Credits, random packs, resources, or routine Foundry rushes."/>
                                <Button Content="CHECK A SHOP PURCHASE" Style="{StaticResource AccentButton}" Margin="0,10,0,0" Click="OnOpenShopTab"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="ACTIVE GOALS" Style="{StaticResource H2}"/>
                                <ItemsControl x:Name="GoalSummaryList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="TRUST RULE" Style="{StaticResource H2}"/>
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource Dim}"
                                           Text="The app tracks what you explicitly confirm. It does not invent account progress from incomplete logs, and community tiers are never treated as objective truth."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="NAVIGATOR">
                <Grid Margin="12" MaxWidth="1050" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="WHERE DO I GET / BUILD THIS?" Style="{StaticResource H2}"/>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource Dim}"
                                       Text="The advisor will resolve the exact variant, blueprint, components, prerequisites, node/activity, tradability, craft time, slots, and current market alternative."/>
                            <TextBox x:Name="AcquireBox" Margin="0,10,0,0" ToolTip="Example: Cedo, Helminth Segment, Mesa Prime Systems, Necramech"/>
                            <Button Content="MAP THE FULL ACQUISITION PATH" Style="{StaticResource AccentButton}" Click="OnAskAcquire" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Official quest guide" Click="OnOpenQuestGuide"/>
                                <Button Content="Official drop tables" Click="OnOpenDropTables" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="KEEP, SELL, DUCAT OR SUBSUME?" Style="{StaticResource H2}"/>
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource Dim}"
                                           Text="Checks Mastery, crafting ingredients, rarity/reacquisition, investment, set completion, current Platinum/Ducat value, and Helminth eligibility."/>
                                <TextBox x:Name="DispositionBox" Margin="0,10,0,0" ToolTip="Example: Broken War, duplicate Paris Prime String, regular Wisp"/>
                                <Button Content="CHECK BEFORE I DESTROY IT" Click="OnAskDisposition" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="BUILD TRANSLATOR" Style="{StaticResource H2}"/>
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource Dim}"
                                           Text="Turns a community showcase into a minimum viable build, upgrade ladder, forma plan, replacement mods, and mission-specific final version."/>
                                <TextBox x:Name="BuildBox" Margin="0,10,0,0" ToolTip="Frame/weapon and goal, e.g. Lavos Prime Steel Path status build"/>
                                <Button Content="MAKE A BUILD I CAN ACTUALLY USE" Click="OnAskBuild" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="ShopTab" Header="SHOP GUARDIAN">
                <Grid Margin="12" MaxWidth="1150" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Paste the item or offer before spending Platinum" Style="{StaticResource H2}"/>
                        <Grid Grid.Row="1" Margin="0,8,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="PurchaseBox" ToolTip="Examples: 150,000 Credits, Rhino, Forma Bundle, weapon slots"/>
                            <Button Grid.Column="1" Content="EVALUATE" Style="{StaticResource AccentButton}" Click="OnEvaluatePurchase" Margin="8,0,0,0"/>
                        </Grid>
                        <Border Grid.Row="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="VerdictText" Text="CHECK BEFORE BUYING" FontFamily="Consolas" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}"/>
                                <TextBlock x:Name="VerdictTitle" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <TextBlock x:Name="VerdictReason" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="BETTER OPTION" Style="{StaticResource H2}" Margin="0,14,0,0"/>
                                <TextBlock x:Name="VerdictBetter" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Gold}"/>
                                <TextBlock x:Name="VerdictIntel" TextWrapping="Wrap" Style="{StaticResource Dim}" Margin="0,12,0,0"/>
                                <Button Content="ASK ADVISOR FOR EXACT COMPARISON" Click="OnAskPurchase" Margin="0,14,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="HARD NO" Style="{StaticResource H2}" Foreground="{DynamicResource Brush.Danger}"/>
                                <TextBlock Text="• Credits for Platinum&#10;• Routine resources or Endo&#10;• Random mod packs&#10;• Normal Foundry rushing" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="USUALLY BAD" Style="{StaticResource H2}" Foreground="{DynamicResource Brush.Warn}"/>
                                <TextBlock Text="• Base Warframes and weapons&#10;• Random relic packs&#10;• Bundles whose filler hides the real price&#10;• Boosters with no farming plan" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="PLATINUM THAT AGES WELL" Style="{StaticResource H2}" Foreground="{DynamicResource Brush.Accent}"/>
                                <TextBlock Text="• Warframe and weapon slots first&#10;• Needed capacity, not speculative capacity&#10;• Planned boosters when you will use the hours&#10;• Cosmetics from a separate fashion budget" TextWrapping="Wrap"/>
                                <TextBlock Text="Catalysts, Reactors and Forma are conditional: validate the item and final build first." Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="REDEEM &amp; CLAIM">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="OPEN OFFICIAL REDEEM PAGE" Style="{StaticResource AccentButton}" Click="OnOpenRedeem"/>
                        <Button Content="IMPORT CODE LIST JSON" Click="OnImportCodes" Margin="8,0,0,0"/>
                        <TextBlock x:Name="CodeStatus" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="220"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="CodeBox" ToolTip="Code" Margin="0,0,8,0"/>
                        <TextBox x:Name="CodeTitleBox" Grid.Column="1" ToolTip="Campaign / title" Margin="0,0,8,0"/>
                        <TextBox x:Name="CodeRewardBox" Grid.Column="2" ToolTip="Reward" Margin="0,0,8,0"/>
                        <Button Grid.Column="3" Content="ADD / UPDATE" Click="OnAddCode"/>
                    </Grid>
                    <DataGrid x:Name="CodesGrid" Grid.Row="2" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="180"/>
                            <DataGridTextColumn Header="CAMPAIGN" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="REWARD" Binding="{Binding Reward}" Width="*"/>
                            <DataGridTextColumn Header="STATE" Binding="{Binding State}" Width="100"/>
                            <DataGridTemplateColumn Header="ACTIONS" Width="190">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal">
                                    <Button Content="Redeem" Tag="{Binding}" Click="OnRedeemCode" Margin="0,0,5,0"/>
                                    <Button Content="Claimed" Tag="{Binding}" Click="OnClaimCode"/>
                                </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="GOAL STACK">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="ADD A GOAL" Style="{StaticResource H2}"/>
                            <Label Content="Goal"/><TextBox x:Name="GoalTitleBox"/>
                            <Label Content="Target item / system"/><TextBox x:Name="GoalTargetBox"/>
                            <Label Content="Category"/><ComboBox x:Name="GoalCategoryBox"/>
                            <Label Content="Priority"/><ComboBox x:Name="GoalPriorityBox"/>
                            <Label Content="Notes"/><TextBox x:Name="GoalNotesBox" AcceptsReturn="True" Height="95" TextWrapping="Wrap"/>
                            <Button Content="ADD GOAL" Style="{StaticResource AccentButton}" Click="OnAddGoal" Margin="0,10,0,0"/>
                            <Button Content="ASK AI TO COMBINE MY GOALS" Click="OnAskGoalStack" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <ListBox x:Name="GoalsList" Grid.Column="1">
                        <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TargetName}" Foreground="{DynamicResource Brush.Gold}"/>
                                    <TextBlock Text="{Binding Category}" Style="{StaticResource Dim}"/>
                                    <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding PriorityDisplay}" FontFamily="Consolas" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Right"/>
                                    <Button Content="Complete" Tag="{Binding}" Click="OnCompleteGoal" Margin="0,8,0,4"/>
                                    <Button Content="Delete" Tag="{Binding}" Click="OnDeleteGoal"/>
                                </StackPanel>
                            </Grid>
                        </Border></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
