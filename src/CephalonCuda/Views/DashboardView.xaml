<UserControl x:Class="CephalonCuda.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextElement.Foreground="{DynamicResource Brush.Text}">
    <Grid Margin="{DynamicResource Metric.PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource HeroCard}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="●" Foreground="{DynamicResource Brush.Success}" FontSize="9" Margin="0,0,6,0"/>
                                <TextBlock Text="LIVE OPERATIONS" Style="{StaticResource Eyebrow}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Pill}">
                            <TextBlock Text="WORLD STATE + LOCAL INTEL" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource Brush.TextDim}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Live Overview" Style="{StaticResource H1}" Margin="0"/>
                    <TextBlock Text="Current fissures, rotations, alerts, invasions, and time-sensitive opportunities in one clean command surface."
                               Style="{StaticResource Dim}" TextWrapping="Wrap" MaxWidth="720" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="↻  Refresh world state" Click="OnRefresh"
                        Style="{StaticResource AccentButton}" VerticalAlignment="Center" Padding="17,8"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="VOID FISSURES" Style="{StaticResource H2}" Margin="0"/>
                            <TextBlock Text="Match relics to the right mission without tab-hopping." Style="{StaticResource Dim}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource Surface}" Padding="10,7" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="SteelPathOnly" Content="Steel Path" Checked="OnFilterChanged" Unchecked="OnFilterChanged" Margin="0,0,14,0"/>
                                <CheckBox x:Name="StormsOnly" Content="Void Storms" Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <DataGrid x:Name="FissureGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TIER" Binding="{Binding Tier}" Width="82"/>
                            <DataGridTextColumn Header="MISSION" Binding="{Binding Mission}" Width="125"/>
                            <DataGridTextColumn Header="NODE" Binding="{Binding Node}" Width="*"/>
                            <DataGridTextColumn Header="ENEMY" Binding="{Binding Enemy}" Width="88"/>
                            <DataGridTextColumn Header="MODE" Binding="{Binding Mode}" Width="76"/>
                            <DataGridTextColumn Header="ETA" Binding="{Binding Eta}" Width="92"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="OPEN WORLD CYCLES" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="CyclesText" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="SORTIE" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="SortieText" TextWrapping="Wrap" LineHeight="19"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="ARCHON HUNT" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="ArchonText" TextWrapping="Wrap" LineHeight="19"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="VOID TRADER" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="BaroText" TextWrapping="Wrap"/>
                            <ListBox x:Name="BaroInventory" MaxHeight="180" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="ARBITRATION &amp; ALERTS" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="ArbitrationText" TextWrapping="Wrap"/>
                            <TextBlock x:Name="AlertsText" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="INVASIONS" Style="{StaticResource H2}"/>
                            <ItemsControl x:Name="InvasionList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Surface}" Margin="0,0,0,7" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/>
                                                <ProgressBar Value="{Binding Completion, Mode=OneWay}" Maximum="100" Margin="0,7,0,5"/>
                                                <TextBlock Text="{Binding Rewards}" Style="{StaticResource Dim}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="NEWS" Style="{StaticResource H2}"/>
                            <ItemsControl x:Name="NewsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,7" Style="{StaticResource Dim}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
