<UserControl x:Class="CephalonCuda.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextElement.Foreground="{DynamicResource Brush.Text}">
    <Grid Margin="{DynamicResource Metric.PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="ARSENAL VALUE" Style="{StaticResource Eyebrow}" Margin="0,0,0,5"/>
                <TextBlock Text="Inventory" Style="{StaticResource H1}" Margin="0"/>
                <TextBlock Text="Track ownership, quantities, live value, and what is safe to sell or keep." Style="{StaticResource Dim}" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Content="↻  Refresh prices" Click="OnRefreshPrices" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Totals -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Style="{StaticResource Card}" Margin="0,0,10,0" MinWidth="160">
                <StackPanel>
                    <TextBlock Text="TOTAL VALUE" Style="{StaticResource Dim}"/>
                    <TextBlock x:Name="TotalPlatText" Text="0 p" FontFamily="Consolas" FontSize="22"
                               Foreground="{DynamicResource Brush.Accent}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,10,0" MinWidth="160">
                <StackPanel>
                    <TextBlock Text="TOTAL DUCATS" Style="{StaticResource Dim}"/>
                    <TextBlock x:Name="TotalDucatsText" Text="0 d" FontFamily="Consolas" FontSize="22"
                               Foreground="{DynamicResource Brush.Gold}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" MinWidth="160">
                <StackPanel>
                    <TextBlock Text="TRACKED ITEMS" Style="{StaticResource Dim}"/>
                    <TextBlock x:Name="ItemCountText" Text="0" FontFamily="Consolas" FontSize="22"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Add row -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="NameBox" Width="340" TextChanged="OnNameChanged"
                             ToolTip="Item name, e.g. 'Wisp Prime Systems'"/>
                    <TextBox x:Name="QtyBox" Width="60" Text="1" Margin="8,0,0,0"/>
                    <Button Content="+ Add / update" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="OnAdd"/>
                    <TextBlock x:Name="AddStatus" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <ListBox x:Name="SuggestionList" MaxHeight="140" Visibility="Collapsed" Margin="0,6,0,0"
                         MouseUp="OnSuggestionPicked"/>
            </StackPanel>
        </Border>

        <!-- Items -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <DockPanel>
                <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                         TextChanged="OnFilterChanged" ToolTip="Filter items…"/>
                <DataGrid x:Name="ItemsGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ITEM" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="60"/>
                        <DataGridTextColumn Header="UNIT PLAT" Binding="{Binding UnitPlat, StringFormat={}{0:0.#}}" Width="90"/>
                        <DataGridTextColumn Header="TOTAL PLAT" Binding="{Binding TotalPlat, StringFormat={}{0:0.#}}" Width="100"/>
                        <DataGridTextColumn Header="DUCATS" Binding="{Binding TotalDucats}" Width="80"/>
                        <DataGridTemplateColumn Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" Style="{StaticResource DangerButton}" Padding="6,2"
                                            Click="OnDelete" Tag="{Binding Id}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
